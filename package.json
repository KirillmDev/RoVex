{
  "name": "rovex",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.mjs --dev --watch",
    "build:dev": "node scripts/build.mjs --dev",
    "build": "node scripts/build.mjs",
    "build:prod": "npm run build",
    "build:popup": "vite build --mode popup",
    "build:background": "vite build --mode background",
    "build:bridge": "vite build --mode bridge",
    "build:content": "vite build --mode content",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@eslint/js": "10.0.1",
    "@types/chrome": "0.3.7",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "17.14.0",
    "jsdom": "27.4.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "7.3.8",
    "vitest": "4.1.12"
  }
}
